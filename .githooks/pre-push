#!/usr/bin/env bash
# The fast half of the offline gate, run against what is actually being pushed.
#
# It used to run in the working tree, which is a proxy for the commits and not
# the same thing. The proxy holds for one developer with a clean checkout and
# fails in both directions otherwise. The loud direction: a second agent working
# in `src/` made three of the four steps fail on files that were not in the push
# at all, so a green commit could not leave the machine. The quiet direction is
# worse — a commit that is red on a fresh clone passes this hook whenever the
# fix is sitting uncommitted in the tree, which is exactly the failure the hook
# exists to prevent. It found one on its first run: the docs gate was passing
# only because somebody's gitignored concept-studio workspace happened to be on
# disk.
#
# So: check out each pushed commit into a throwaway worktree and gate that. The
# working tree is never read, never stashed, and never touched — which also
# makes the hook safe to run while somebody else is editing it.
#
# About a minute warm, most of it the contract suite, plus FX's engine build: cargo
# reuses the submodule's own build when the pin is checked out clean, and a dirty or
# off-pin submodule rebuilds the engine's crates, which takes a few minutes. Needs
# cargo (https://rustup.rs) and Bun (https://bun.sh). Install once with:
#   git config core.hooksPath .githooks
set -euo pipefail

repository="$(git rev-parse --show-toplevel)"
cd "$repository"

ZERO="0000000000000000000000000000000000000000"

# Status is captured rather than inherited. The first cut of this used `set -e`
# with a RETURN trap and got both halves wrong: a failing gate exited 0, so a red
# ref would have been pushed, and the throwaway worktree was left registered
# because `set -e` aborts before a RETURN trap runs. Neither is visible unless
# the hook is tested against a commit that is actually red, which is the one test
# a gate has to pass.
cleanup() {
	local scratch="$1"
	[ -n "$scratch" ] || return 0
	git worktree remove --force "$scratch" >/dev/null 2>&1 || true
	rm -rf "$scratch"
	git worktree prune >/dev/null 2>&1 || true
}

# FX's engine for the pinned FX commit, placed where the scratch tree's grida finds it.
# FX's own tools/build_engine.py builds it, as the gate does: the engine embeds FX's
# viewer, which Bun builds first, and plain cargo cannot. The submodule's own build is
# reused when it is checked out clean at the pin. Any other state installs and builds the
# archived copy into its own target folder: cargo judges freshness by mtime, so two source
# trees sharing one target folder would each look fresh to the other.
build_engine() {
	local scratch="$1" fx="$2" here="$repository/third_party/fx" source target tool
	for tool in cargo bun python3; do
		command -v "$tool" >/dev/null 2>&1 || {
			echo "pre-push: $tool is not on PATH; FX's engine is built from third_party/fx with cargo, Bun and Python" >&2
			return 1
		}
	done
	if [ "$(git -C "$here" rev-parse HEAD 2>/dev/null)" = "$fx" ] &&
		[ -z "$(git -C "$here" status --porcelain --untracked-files=all)" ]; then
		source="$here" target="$here/target"
	else
		source="$scratch/third_party/fx" target="$here/target/pre-push"
		(cd "$source" && bun --no-env-file install --frozen-lockfile --silent) || return 1
	fi
	CARGO_INCREMENTAL=0 CARGO_TARGET_DIR="$target" \
		python3 "$source/tools/build_engine.py" >/dev/null || return 1
	mkdir -p "$scratch/third_party/fx/python/src/grida/fx/_bin"
	install -m 0755 "$target/release/grida-fx" "$scratch/third_party/fx/python/src/grida/fx/_bin/grida-fx"
}

gate() {
	local sha="$1" ref="$2" scratch status=0
	scratch="$(mktemp -d "${TMPDIR:-/tmp}/fx-games-prepush.XXXXXX")"
	# shellcheck disable=SC2064
	trap "cleanup '$scratch'" EXIT

	echo "pre-push: gating ${ref} at ${sha:0:12} in a clean worktree"
	if ! git worktree add -q --detach "$scratch" "$sha"; then
		cleanup "$scratch"
		trap - EXIT
		echo "pre-push: could not check out ${sha:0:12}" >&2
		return 1
	fi
	# A worktree checks out no submodule, and `uv sync` installs grida from third_party/fx.
	# Copy the FX commit this commit pins out of the local submodule: no network, no clone.
	# `-m` stamps the files now: `git archive` stamps them with the commit time, and cargo
	# judges freshness by mtime.
	local fx
	fx="$(git -C "$scratch" rev-parse --verify --quiet "HEAD:third_party/fx" || true)"
	if [ -n "$fx" ]; then
		mkdir -p "$scratch/third_party/fx"
		if ! git -C "$repository/third_party/fx" archive "$fx" | tar -x -m -C "$scratch/third_party/fx"; then
			cleanup "$scratch"
			trap - EXIT
			echo "pre-push: third_party/fx pins ${fx:0:12}, which the local submodule lacks (git submodule update --init)" >&2
			return 1
		fi
		if ! build_engine "$scratch" "$fx"; then
			cleanup "$scratch"
			trap - EXIT
			echo "pre-push: could not build FX's engine at ${fx:0:12}" >&2
			return 1
		fi
	fi
	(
		cd "$scratch"
		# FX runs offline here, on this tree's engine and interpreter, and reads no .env.
		export GRIDA_FX_BIN="$scratch/third_party/fx/python/src/grida/fx/_bin/grida-fx" \
			GRIDA_FX_PYTHON="$scratch/.venv/bin/python" GRIDA_FX_DISABLE_DOTENV=1 GRIDA_FX_NETWORK=off
		uv sync --all-groups --frozen --quiet
		uv run --all-groups ruff format --check .
		uv run --all-groups ruff check .
		(cd web/site && bun install --frozen-lockfile --silent && bun test)
		uv run --all-groups pytest tests/contract -q
	) || status=$?
	cleanup "$scratch"
	trap - EXIT
	return "$status"
}

pushed=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	# A branch deletion pushes no content, so there is nothing to gate.
	[ "$local_sha" = "$ZERO" ] && continue
	if ! gate "$local_sha" "${_remote_ref:-HEAD}"; then
		echo "pre-push: ${_remote_ref:-HEAD} is red at ${local_sha:0:12}; nothing pushed" >&2
		exit 1
	fi
	pushed=1
done

# Git gives the refs on stdin. Nothing there means nothing to push, and gating
# HEAD instead would be gating something the push never mentioned.
if [ "$pushed" -eq 0 ]; then
	echo "pre-push: nothing to gate"
fi
