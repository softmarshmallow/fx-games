# The credentials and endpoints Grida FX reads. Leave the credentials blank in source control.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=

# The Tripo credential the character-3d workflow's mesh and rig routes use.
TRIPO_API_KEY=

# Optional provider endpoints.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FAL_BASE_URL=https://fal.run
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# The viewer's run folders, joined by the platform's path separator. `scripts/view.py` sets it
# from the folders it is given; blank: out/ of the checkout.
STAGE_GEN_RUN_ROOTS=
# The checkout the viewer belongs to. Blank: the nearest pyproject.toml named stage-gen.
STAGE_GEN_REPO_ROOT=
# Set by `scripts/view.py`: the catalog the viewer exported, and the cache scripts/view.py
# keeps run views in. Blank: the viewer lists runs ungrouped and draws only views a run
# carries itself.
STAGE_GEN_CATALOG=
STAGE_GEN_VIEW_CACHE=
