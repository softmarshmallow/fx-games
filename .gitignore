.vite/

# Local experiment sandbox (spike only, never shipped)
spikes/

# Local concept folders (made with skills/game-concept-studio); promoted packages live under
# concept-studio/gallery.
/concept-studio/workspaces/

# Local dialogue capture evidence remains unreviewed until publication gates promote it.
/web/output/playwright/dialogue-overlay/

# Session workspaces, never tracked (was only in .git/info/exclude, which a clone does not see).
local/

# Ember Hollow's adopted takes stay local: first-party draws that exceed the tracked-media
# policy (docs/repository-storage.md) in size and in location, and are declared by sha256 in
# the package TOMLs, so planning and graph identity need only the digest. The two reference
# images beside them are tracked.
/godot/games/ember_hollow/inputs/ground/*.take.png
/godot/games/ember_hollow/inputs/items/*.take.png
/godot/games/ember_hollow/inputs/weather/*.take.png
/godot/games/ember_hollow/inputs/music/*.take.mp3
/godot/games/ember_hollow/inputs/sounds/*.take.mp3
/godot/games/ember_hollow/inputs/shell/*.take.mp4

# The Godot project: the editor's import cache is derived and an export is a
# build, so neither is tracked. The project ships no media, so there are no
# *.import records to keep; if one ever appears it is the import contract for a
# tracked file and belongs in the tree with it. Signing identities and
# encryption keys live in export_credentials.cfg, which is machine-specific;
# the presets themselves declare the build and are tracked with it.
/godot/**/.godot/
/godot/**/build/
/godot/**/export_credentials.cfg
/godot/games/ember_hollow/inputs/ground/*.take.png.meta.json
/godot/games/ember_hollow/inputs/items/*.take.png.meta.json
/godot/games/ember_hollow/inputs/weather/*.take.png.meta.json
/godot/games/ember_hollow/inputs/music/*.take.mp3.meta.json
/godot/games/ember_hollow/inputs/sounds/*.take.mp3.meta.json
/godot/games/ember_hollow/inputs/shell/*.take.mp4.meta.json
